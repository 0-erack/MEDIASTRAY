{
  "type": "module",
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start-old": "node server.mjs",
    "dev-old": "nodemon server.mjs",
    "start": "npm run build && node dist/server.js",
    "dev-old2": "nodemon --recursive --watch 'src/**/*.ts' --exec tsx server.ts",
    "dev": "nodemon --legacy-watch --watch './**/*.ts' --ext ts,json --exec tsx server.ts",
    "dockerprod": "sh prod.sh",
    "dockerdev": "sh dev.sh",
    "build-old": "npx tsc && (cp -r src dist/ 2>/dev/null || true) && cp .env dist/ 2>/dev/null || true",
    "build": "rm -rf dist && tsc --project tsconfig.json && npx esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.1.0",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "multer": "^2.0.2",
    "pg": "^8.19.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "redis": "^5.10.0",
    "stream": "^0.0.3",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/mongodb": "^4.0.6",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.2",
    "@types/pg": "^8.18.0",
    "@types/redis": "^4.0.10",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
