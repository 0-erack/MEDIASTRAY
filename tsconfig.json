{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "removeComments": true,
    "sourceMap": false,
    "declaration": false,
    "newLine": "lf",
    "noImplicitAny": false,
    "pretty": false
  },
  "include": ["server.ts", "src/**/*.ts"] 
}