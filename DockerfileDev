# backend/Dockerfile

FROM node:trixie

WORKDIR /usr/src/app

COPY package*.json ./

#RUN npm install --only=production

RUN npm install

COPY . .

EXPOSE 8510
EXPOSE 8520

WORKDIR /usr/src/app/frontend
RUN npm install
#RUN npm run build
#RUN npm run dev -- --port 8520 &
WORKDIR /usr/src/app
RUN npm run build
#CMD npx drizzle-kit push && npm run dev
#CMD ["node", "server.mjs"]
#CMD ["npm", "run", "dev"]
# Use a single execution line that keeps the process in the foreground
CMD npx drizzle-kit push && npx concurrently \
    --kill-others \
    --raw \
    "npx tsx watch server.ts" \
    "npm run dev --prefix frontend -- --port 8520 --host 0.0.0.0"
